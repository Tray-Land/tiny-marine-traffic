<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyMarineTraffic.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps"
    xmlns:views="using:TinyMarineTraffic.Views"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="OverlayStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>
    <Grid x:Name="Root">
        <map:MapControl x:Name="Map" MapStyle="Blank"
            AutomationProperties.AutomationId="TrafficMap"
            AutomationProperties.Name="Marine traffic map. Pan and zoom, then choose Save area to save a spot." />
        <Grid x:Name="AreaCrosshair" Width="26" Height="26" Visibility="Collapsed" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="6" Margin="4" />
            <Ellipse Stroke="{ThemeResource SystemControlHighlightAccentBrush}" StrokeThickness="2" Margin="4" />
            <Border Width="2" Background="{ThemeResource SystemControlHighlightAccentBrush}" />
            <Border Height="2" Background="{ThemeResource SystemControlHighlightAccentBrush}" />
        </Grid>
        <Border x:Name="MapCover" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <ProgressRing x:Name="MapLoadingRing" Width="28" Height="28" IsActive="True" />
                <TextBlock Text="Opening your waterway" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
        <Grid Padding="8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="12,6,4,6" Style="{StaticResource OverlayStyle}">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tiny Marine Traffic" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ConnectionText" AutomationProperties.AutomationId="ConnectionText"
                            Text="Connecting to Open Waters" Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="ChangePlaceButton" Grid.Column="1"
                        AutomationProperties.AutomationId="ChangePlaceButton" AutomationProperties.Name="Change place"
                        Style="{StaticResource FlyoutIconButtonStyle}" ToolTipService.ToolTip="Change place">
                        <FontIcon FontSize="16" Glyph="&#xE707;" />
                        <Button.Flyout>
                            <Flyout x:Name="PlacesFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="280" Spacing="12">
                                    <ComboBox x:Name="HarborPicker" Header="Waterway" HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="HarborPicker" AutomationProperties.Name="Waterway"
                                        SelectionChanged="Harbor_Changed" />
                                    <Button x:Name="SaveAreaButton" Content="Save area" Click="BeginPickArea_Click"
                                        AutomationProperties.AutomationId="SaveAreaButton"
                                        ToolTipService.ToolTip="Pick a spot on the map and save it, optionally as home" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="HomeButton" Grid.Column="2" AutomationProperties.AutomationId="HomeButton"
                        AutomationProperties.Name="Go to home area" Click="Home_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}" ToolTipService.ToolTip="Go to home area">
                        <FontIcon FontSize="16" Glyph="&#xE80F;" />
                    </Button>
                    <Button x:Name="RefreshButton" Grid.Column="3" AutomationProperties.AutomationId="RefreshButton"
                        AutomationProperties.Name="Reconnect traffic" Click="Refresh_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}" ToolTipService.ToolTip="Reconnect traffic">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                    <Button Grid.Column="4" AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="Settings" Click="Settings_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}" ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                </Grid>
            </Border>
            <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Warning"
                AutomationProperties.AutomationId="StatusBar" />
            <Border Grid.Row="3" Padding="12,8" Style="{StaticResource OverlayStyle}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ListHeader">
                        <TextBlock x:Name="CountText" Text="Vessels nearby" Style="{StaticResource BodyStrongTextBlockStyle}"
                            AutomationProperties.AutomationId="CountText" />
                        <ToggleButton x:Name="MovingToggle" Content="Moving only" IsChecked="True" HorizontalAlignment="Right"
                            FontSize="12" Padding="8,3" Click="Moving_Click" AutomationProperties.AutomationId="MovingToggle" />
                    </Grid>
                    <Grid x:Name="TrafficListPanel" Grid.Row="1">
                        <ListView x:Name="VesselList" MaxHeight="144" ItemsSource="{x:Bind Rows, Mode=OneWay}" IsItemClickEnabled="True"
                            ContainerContentChanging="Vessel_ContainerContentChanging"
                            ItemClick="Vessel_Click" SelectionMode="None" AutomationProperties.AutomationId="VesselList"
                            AutomationProperties.Name="Nearby vessels, moving vessels first">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,5" />
                                    <Setter Property="MinHeight" Value="48" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:VesselRow">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Speed, Mode=OneWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyText" Margin="0,16" Text="Waiting for vessel reports"
                            TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <StackPanel x:Name="DetailPanel" Grid.RowSpan="2" Visibility="Collapsed" Spacing="5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VesselName" TextWrapping="Wrap" Style="{StaticResource SubtitleTextBlockStyle}"
                                AutomationProperties.AutomationId="VesselName" />
                            <Button Grid.Column="1" Click="CloseDetail_Click" AutomationProperties.AutomationId="CloseDetailButton"
                                AutomationProperties.Name="Back to vessel list" ToolTipService.ToolTip="Back to vessel list"
                                Style="{StaticResource FlyoutIconButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="VesselType" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="VesselMotion" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="VesselPosition" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="VesselMeta" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VesselDestination" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="PickAreaPanel" Grid.RowSpan="2" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Tap a spot, or pan and zoom. The crosshair marks the center; the outline shows the saved area."
                            TextWrapping="Wrap" FontSize="12" />
                        <TextBlock x:Name="AreaPreviewText" FontSize="12" TextWrapping="Wrap"
                            AutomationProperties.AutomationId="AreaPreviewText" />
                        <TextBox x:Name="PickedAreaNameBox" Header="Area name" MaxLength="40"
                            AutomationProperties.AutomationId="PickedAreaNameBox" />
                        <CheckBox x:Name="MakeHomeCheck" Content="Make this my home area" IsChecked="True"
                            AutomationProperties.AutomationId="MakeHomeCheck" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConfirmAreaButton" Content="Save area" Click="SavePickedArea_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="ConfirmAreaButton" />
                            <Button Content="Cancel" Click="CancelPickArea_Click"
                                AutomationProperties.AutomationId="CancelPickAreaButton" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="4" Padding="8,2" Style="{StaticResource OverlayStyle}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AreaText" VerticalAlignment="Center" FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1" Content="Data credits" Click="Credits_Click" Padding="4,2"
                        FontSize="10" Background="Transparent" BorderThickness="0"
                        AutomationProperties.AutomationId="CreditsButton">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel MaxWidth="320" Spacing="8">
                                    <TextBlock Text="Data and coverage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="AttributionText" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="AIS is incomplete and may be delayed. Not for navigation."
                                        TextWrapping="Wrap" FontSize="12" />
                                    <HyperlinkButton Content="Open Waters AIS" NavigateUri="https://openwaters.io/ais/" Padding="0"
                                        AutomationProperties.AutomationId="OpenWatersLink" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
