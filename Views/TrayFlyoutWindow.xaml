<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TinyMarineTraffic.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    Title="Tiny Marine Traffic">

    <Grid x:Name="PopupRoot" KeyboardAcceleratorPlacementMode="Hidden" PointerPressed="Root_PointerPressed">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <ContentPresenter x:Name="PageHost">
            <ContentPresenter.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition HorizontalOffset="24" />
                </TransitionCollection>
            </ContentPresenter.ContentTransitions>
        </ContentPresenter>
    </Grid>
</ex:WindowEx>
