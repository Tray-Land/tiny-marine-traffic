<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TinyMarineTraffic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="MapVesselColor">#006D77</Color>
                    <Color x:Key="MapStationaryColor">#59636D</Color>
                    <Color x:Key="MapSelectedColor">#B64A00</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="MapVesselColor">#006D77</Color>
                    <Color x:Key="MapStationaryColor">#59636D</Color>
                    <Color x:Key="MapSelectedColor">#B64A00</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="MapVesselColor">{ThemeResource SystemColorHighlightColor}</Color>
                    <Color x:Key="MapStationaryColor">{ThemeResource SystemColorWindowTextColor}</Color>
                    <Color x:Key="MapSelectedColor">{ThemeResource SystemColorHotlightColor}</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Compact, borderless icon button for the flyout header.  -->
            <Style
                x:Key="FlyoutIconButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
